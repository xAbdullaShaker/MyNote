<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <%- include('partials/nav') %>

  <% if (user) { %>
    <h1>Welcome, <%= user.username %>!</h1>
    <a href="/notes">Go to My Notes</a>
  <% } else { %>
    <h1>Welcome to MyNote</h1>
    <p><a href="/auth/sign-up">Sign up</a> or <a href="/auth/sign-in">Sign in</a>.</p>
  <% } %>
</body>
</html>
