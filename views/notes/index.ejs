<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Notes</title>
  <link rel="stylesheet" href="/public/styles.css" /> <!-- optional -->
</head>
<body>
  <%- include('../partials/nav.ejs') %>

  <h1>My Notes</h1>

  <a href="/notes/new">➕ Create New Note</a>

  <% if (notes.length === 0) { %>
    <p>You don’t have any notes yet.</p>
  <% } else { %>
    <ul>
      <% notes.forEach(note => { %>
        <li>
          <a href="/notes/<%= note._id %>"><%= note.head %></a>
          <p><%= note.body %></p>
          |
          <a href="/notes/<%= note._id %>/edit">Edit</a>
          <form action="/notes/<%= note._id %>?_method=DELETE" method="POST" style="display:inline;">
            <button type="submit">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

</body>
</html>
